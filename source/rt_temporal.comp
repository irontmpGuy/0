#version 450
layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;
struct GpuRtSettings { uvec4 flags; uvec4 modes; vec4 params; };
layout(std430, binding = 18) readonly buffer RtSettingsBuf { GpuRtSettings rt; };
layout(rgba16f, binding = 23) uniform readonly image2D imgRtFiltered;
layout(rgba16f, binding = 24) uniform image2D imgRtHistoryA;
layout(rgba16f, binding = 25) uniform image2D imgRtHistoryB;

void main()
{
    ivec2 pix = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size = imageSize(imgRtFiltered);
    if (pix.x >= size.x || pix.y >= size.y) return;

    vec3 current = imageLoad(imgRtFiltered, pix).rgb;
    bool ping = (rt.modes.w != 0u);
    vec3 previous = ping ? imageLoad(imgRtHistoryA, pix).rgb : imageLoad(imgRtHistoryB, pix).rgb;
    bool valid = rt.modes.y != 0u && rt.flags.x != 0u;

    vec3 outLighting = current;
    if (valid) {
        vec3 mn = current;
        vec3 mx = current;
        for (int y = -1; y <= 1; ++y) {
            for (int x = -1; x <= 1; ++x) {
                ivec2 q = clamp(pix + ivec2(x, y), ivec2(0), size - ivec2(1));
                vec3 c = imageLoad(imgRtFiltered, q).rgb;
                mn = min(mn, c);
                mx = max(mx, c);
            }
        }
        previous = clamp(previous, mn, mx);
        outLighting = mix(current, previous, clamp(rt.params.w, 0.0, 0.98));
    }

    if (ping) imageStore(imgRtHistoryB, pix, vec4(outLighting, 1.0));
    else      imageStore(imgRtHistoryA, pix, vec4(outLighting, 1.0));
}
