#version 450
layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

struct GpuCamera {
    vec4 pos;
    vec4 dir;
    vec4 plane;
    vec4 upPlane;
    vec4 fog;
    vec4 gridMin;
    uvec4 screen;
    uvec4 gridSize;
};
struct GpuRtSettings { uvec4 flags; uvec4 modes; vec4 params; };
struct GpuOverlayRect { ivec4 rect; uvec4 color; };
struct GpuOverlayState { uvec4 info; };

layout(std430, binding = 1) readonly buffer CameraBuf { GpuCamera cam; };
layout(std430, binding = 15) readonly buffer OverlayRects { GpuOverlayRect overlayRects[]; };
layout(std430, binding = 16) readonly buffer OverlayStateBuf { GpuOverlayState overlayState; };
layout(std430, binding = 18) readonly buffer RtSettingsBuf { GpuRtSettings rt; };
layout(rgba8, binding = 19) uniform readonly image2D imgAlbedo;
layout(rgba16f, binding = 20) uniform readonly image2D imgNormal;
layout(r32f, binding = 21) uniform readonly image2D imgDepth;
layout(rgba16f, binding = 23) uniform readonly image2D imgRtFiltered;
layout(rgba8, binding = 26) uniform writeonly image2D imgComposite;

vec3 unpackRgb(uint color)
{
    return vec3(float((color >> 16) & 255u), float((color >> 8) & 255u), float(color & 255u)) / 255.0;
}
vec4 unpackArgb(uint color)
{
    uint ai = (color >> 24) & 255u;
    float a = (ai == 0u) ? 1.0 : float(ai) / 255.0;
    return vec4(unpackRgb(color), a);
}

float hash01(ivec2 pix, uint salt)
{
    uint x = uint(pix.x) * 1973u + uint(pix.y) * 9277u + salt * 26699u + 0x68bc21ebu;
    x ^= x >> 15;
    x *= 2246822519u;
    x ^= x >> 13;
    x *= 3266489917u;
    x ^= x >> 16;
    return float(x & 65535u) / 65535.0;
}

float ditherNoise(ivec2 pix)
{
    // Stable triangular 8-bit dither.  Do not animate it with frameIndex:
    // animated noise hides bands but creates shimmer while turning.
    return (hash01(pix, 0u) + hash01(pix, 1u) - 1.0) / 255.0;
}

vec3 safeNormalize(vec3 v, vec3 fallback)
{
    float l2 = dot(v, v);
    if (l2 <= 1e-12 || any(isnan(v)) || any(isinf(v))) return fallback;
    return v * inversesqrt(l2);
}

void buildCameraBasis(out vec3 forward, out vec3 right, out vec3 up,
                      out float rightLen, out float upLen)
{
    forward = safeNormalize(cam.dir.xyz, vec3(0.0, 0.0, 1.0));

    vec3 rawRight = cam.plane.xyz;
    vec3 rawUp = cam.upPlane.xyz;
    rightLen = max(length(rawRight), 1e-6);
    upLen = max(length(rawUp), 1e-6);

    right = rawRight - forward * dot(rawRight, forward);
    if (dot(right, right) <= 1e-12) {
        right = cross(rawUp, forward);
        if (dot(right, right) <= 1e-12) right = cross(vec3(0.0, 1.0, 0.0), forward);
        if (dot(right, right) <= 1e-12) right = vec3(1.0, 0.0, 0.0);
    }
    right = safeNormalize(right, vec3(1.0, 0.0, 0.0));
    if (dot(rawRight, rawRight) > 1e-12 && dot(right, rawRight) < 0.0) right = -right;

    up = rawUp - forward * dot(rawUp, forward) - right * dot(rawUp, right);
    if (dot(up, up) <= 1e-12) {
        up = rawUp - forward * dot(rawUp, forward);
    }
    if (dot(up, up) <= 1e-12) {
        up = vec3(0.0, 1.0, 0.0) - forward * dot(vec3(0.0, 1.0, 0.0), forward);
    }
    if (dot(up, up) <= 1e-12) up = cross(forward, right);
    up = safeNormalize(up, vec3(0.0, 1.0, 0.0));
    if (dot(rawUp, rawUp) > 1e-12 && dot(up, rawUp) < 0.0) up = -up;
}

vec3 reconstructWorldPosition(ivec2 pix, float depth)
{
    vec2 size = vec2(imageSize(imgDepth));
    float ndcX = (float(pix.x) + 0.5) / max(size.x, 1.0) * 2.0 - 1.0;
    float ndcY = (float(pix.y) + 0.5) / max(size.y, 1.0) * 2.0 - 1.0;
    float nearZ = 0.03;
    float farZ = max(cam.fog.x, nearZ + 1.0);
    float z = nearZ + clamp(depth, 0.0, 1.0) * (farZ - nearZ);

    vec3 forward, right, up;
    float rightLen, upLen;
    buildCameraBasis(forward, right, up, rightLen, upLen);

    return cam.pos.xyz + forward * z + right * (ndcX * z * rightLen) + up * (-ndcY * z * upLen);
}

vec3 applyFog(vec3 rgb, float dist)
{
    if (cam.screen.w != 0u) return rgb;

    float fogMax = cam.fog.y;
    float fogFactor = cam.fog.z;
    float minFog = cam.fog.w;
    float fogStart = cam.gridMin.w;

    float minI = clamp(1.0 - minFog / 100.0, 0.0, 1.0);
    rgb *= minI;

    if (dist >= fogStart) {
        if (dist >= fogMax) return vec3(0.0);
        float normD = (dist - fogStart) / max(fogMax - fogStart, 0.0001);
        float f = clamp(fogFactor / 100.0, 0.01, 1.0);
        float intensity = pow(1.0 - normD, 1.0 / f);
        rgb *= intensity;
    }
    return rgb;
}


vec3 decodeNormal(ivec2 p)
{
    return safeNormalize(imageLoad(imgNormal, p).xyz * 2.0 - 1.0, vec3(0.0, 1.0, 0.0));
}

ivec2 rtToFullPix(ivec2 rtPix, ivec2 rtSize, ivec2 fullSize)
{
    vec2 uv = (vec2(rtPix) + vec2(0.5)) / max(vec2(rtSize), vec2(1.0));
    return clamp(ivec2(floor(uv * vec2(fullSize))), ivec2(0), fullSize - ivec2(1));
}

vec3 upscaleRtLighting(ivec2 pix, ivec2 fullSize)
{
    ivec2 rtSize = imageSize(imgRtFiltered);
    if (rtSize.x <= 0 || rtSize.y <= 0) return vec3(1.0);

    // Fast exact path at 100% RT quality: RT image == full render image.
    if (rtSize.x == fullSize.x && rtSize.y == fullSize.y) {
        return imageLoad(imgRtFiltered, pix).rgb;
    }

    vec2 uv = (vec2(pix) + vec2(0.5)) / max(vec2(fullSize), vec2(1.0));
    vec2 rtCoord = uv * vec2(rtSize) - vec2(0.5);
    ivec2 base = ivec2(floor(rtCoord));
    vec2 frac = fract(rtCoord);

    float centerDepth = imageLoad(imgDepth, pix).r;
    vec3 centerNormal = decodeNormal(pix);

    vec3 sum = vec3(0.0);
    float weightSum = 0.0;
    vec3 looseSum = vec3(0.0);
    float looseWeightSum = 0.0;

    // Bilateral 2x2 upscale: normal/depth keep lighting from bleeding across
    // walls and object edges, while bilinear weights keep large flat surfaces smooth.
    for (int y = 0; y <= 1; ++y) {
        for (int x = 0; x <= 1; ++x) {
            ivec2 q = clamp(base + ivec2(x, y), ivec2(0), rtSize - ivec2(1));
            vec3 sampleLight = imageLoad(imgRtFiltered, q).rgb;

            float bw = ((x == 0) ? (1.0 - frac.x) : frac.x) * ((y == 0) ? (1.0 - frac.y) : frac.y);
            bw = max(bw, 0.0001);
            looseSum += sampleLight * bw;
            looseWeightSum += bw;

            ivec2 refPix = rtToFullPix(q, rtSize, fullSize);
            float d = imageLoad(imgDepth, refPix).r;
            vec3 n = decodeNormal(refPix);
            float normalW = pow(max(dot(centerNormal, n), 0.0), 16.0);
            float depthW = exp(-abs(centerDepth - d) * 120.0);
            float w = bw * normalW * depthW;
            sum += sampleLight * w;
            weightSum += w;
        }
    }

    if (weightSum > 0.0001) return sum / weightSum;
    if (looseWeightSum > 0.0001) return looseSum / looseWeightSum;
    ivec2 nearestRt = clamp(ivec2(floor(uv * vec2(rtSize))), ivec2(0), rtSize - ivec2(1));
    return imageLoad(imgRtFiltered, nearestRt).rgb;
}

vec4 applyMenuOverlay(vec4 color, ivec2 pix, ivec2 size)
{
    if (overlayState.info.x == 0u) return color;
    uint windowW = max(overlayState.info.z, 1u);
    uint windowH = max(overlayState.info.w, 1u);
    uint wx = uint((float(pix.x) + 0.5) * float(windowW) / float(max(size.x, 1)));
    uint wy = uint((float(pix.y) + 0.5) * float(windowH) / float(max(size.y, 1)));

    vec4 outColor = vec4(color.rgb * 0.35, color.a);
    uint count = min(overlayState.info.y, 1024u);
    for (uint i = 0u; i < count; ++i) {
        ivec4 r = overlayRects[i].rect;
        if (r.z <= 0 || r.w <= 0) continue;
        if (int(wx) >= r.x && int(wx) < r.x + r.z && int(wy) >= r.y && int(wy) < r.y + r.w) {
            vec4 src = unpackArgb(overlayRects[i].color.x);
            outColor.rgb = mix(outColor.rgb, src.rgb, src.a);
            outColor.a = 1.0;
        }
    }
    return outColor;
}

void main()
{
    ivec2 pix = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size = imageSize(imgAlbedo);
    if (pix.x >= size.x || pix.y >= size.y) return;

    vec4 albedo = imageLoad(imgAlbedo, pix);
    vec3 lighting = vec3(1.0); // RT off = plain raster albedo
    if (rt.flags.x != 0u && rt.modes.x != 0u) {
        lighting = upscaleRtLighting(pix, size);
    }

    vec3 rgb = albedo.rgb * lighting;

    float depth = imageLoad(imgDepth, pix).r;
    if (depth < 0.99999) {
        vec3 worldPos = reconstructWorldPosition(pix, depth);
        rgb = applyFog(rgb, length(worldPos - cam.pos.xyz));
    }

    vec4 finalColor = vec4(clamp(rgb, 0.0, 1.0), albedo.a);

    // Final rgba8 write: dither once, after fog+lighting, before menu overlay.
    finalColor.rgb = clamp(finalColor.rgb + vec3(ditherNoise(pix)), 0.0, 1.0);

    finalColor = applyMenuOverlay(finalColor, pix, size);
    imageStore(imgComposite, pix, finalColor);
}
