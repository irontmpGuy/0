#version 450
layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

struct GpuCamera { vec4 pos; vec4 dir; vec4 plane; vec4 upPlane; vec4 fog; vec4 gridMin; uvec4 screen; uvec4 gridSize; };
struct GpuCell { uint firstItem; uint itemCount; uint pad0; uint pad1; };
struct GpuCellItem { uint type; uint index; uint aux; uint pad; };
struct GpuBox { uint textureIndex; uint pad0; uint pad1; uint pad2; };
struct GpuPlane { vec4 position; vec4 normal; uint textureIndex; uint pad0; uint pad1; uint pad2; };
struct GpuTriangle { vec4 p1; vec4 p2; vec4 p3; vec4 uv12; vec4 uv3; uvec4 meta; };
struct GpuBVHNode { vec4 aabbMin; vec4 aabbMax; uvec4 data; };
struct GpuMesh { vec4 modelMin; vec4 scale; vec4 offset; vec4 modelCenter; vec4 pivot; vec4 rot0; vec4 rot1; vec4 rot2; uvec4 ranges; };
struct GpuMeshCell { uint meshIndex; uint nodeRoot; uint triIdxBase; uint pad; };
struct GpuRemotePlayer {
    vec4 aabbMin;
    vec4 aabbMax;
    vec4 offset;
    vec4 scale;
    vec4 pivot;
    vec4 rot0;
    vec4 rot1;
    vec4 rot2;
    vec4 modelMin;
    vec4 modelCenter;
    uvec4 ranges;
    uvec4 meta;
    uvec4 light; // x = light_on
};

struct GpuLight { vec4 position; vec4 color; vec3 normal; uint angle;};
struct GpuRtSettings { uvec4 flags; uvec4 modes; vec4 params; };

layout(std430, binding = 1) readonly buffer CameraBuf { GpuCamera cam; };
layout(std430, binding = 2) readonly buffer Cells { GpuCell cells[]; };
layout(std430, binding = 3) readonly buffer Items { GpuCellItem items[]; };
layout(std430, binding = 4) readonly buffer Boxes { GpuBox boxes[]; };
layout(std430, binding = 5) readonly buffer Planes { GpuPlane planes[]; };
layout(std430, binding = 8) readonly buffer Meshes { GpuMesh meshes[]; };
layout(std430, binding = 9) readonly buffer MeshCells { GpuMeshCell meshCells[]; };
layout(std430, binding = 10) readonly buffer Triangles { GpuTriangle triangles[]; };
layout(std430, binding = 11) readonly buffer BVHNodes { GpuBVHNode bvhNodes[]; };
layout(std430, binding = 12) readonly buffer TriIdx { uint triIndices[]; };
layout(std430, binding = 13) readonly buffer RemotePlayers { GpuRemotePlayer remotePlayers[]; };
layout(std430, binding = 17) readonly buffer Lights { GpuLight lights[]; };
layout(std430, binding = 18) readonly buffer RtSettingsBuf { GpuRtSettings rt; };

layout(rgba8, binding = 19) uniform readonly image2D imgAlbedo;
layout(rgba16f, binding = 20) uniform readonly image2D imgNormal;
layout(r32f, binding = 21) uniform readonly image2D imgDepth;
layout(rgba16f, binding = 22) uniform writeonly image2D imgRtRaw;

const float INF = 1e30;
const float EPS = 1e-6;
const uint RT_MAX_DDA_STEPS = 512u;
const uint RT_MAX_BVH_STEPS = 4096u;
uint gridIndex(int x, int y, int z)
{
    return uint(x) + uint(y) * cam.gridSize.x + uint(z) * cam.gridSize.x * cam.gridSize.y;
}

bool inBounds(int x, int y, int z)
{
    return x >= 0 && y >= 0 && z >= 0 &&
           x < int(cam.gridSize.x) && y < int(cam.gridSize.y) && z < int(cam.gridSize.z);
}

vec3 mulMat3(vec4 r0, vec4 r1, vec4 r2, vec3 v)
{
    return vec3(dot(r0.xyz, v), dot(r1.xyz, v), dot(r2.xyz, v));
}

vec3 mulMat3T(vec4 r0, vec4 r1, vec4 r2, vec3 v)
{
    return vec3(r0.x*v.x + r1.x*v.y + r2.x*v.z,
                r0.y*v.x + r1.y*v.y + r2.y*v.z,
                r0.z*v.x + r1.z*v.y + r2.z*v.z);
}

vec3 invRay(vec3 dir)
{
    return vec3(abs(dir.x) > 1e-9 ? 1.0 / dir.x : (dir.x >= 0.0 ? INF : -INF),
                abs(dir.y) > 1e-9 ? 1.0 / dir.y : (dir.y >= 0.0 ? INF : -INF),
                abs(dir.z) > 1e-9 ? 1.0 / dir.z : (dir.z >= 0.0 ? INF : -INF));
}

vec3 safeNormalize(vec3 v, vec3 fallback)
{
    float l2 = dot(v, v);
    if (l2 <= 1e-12 || any(isnan(v)) || any(isinf(v))) return fallback;
    return v * inversesqrt(l2);
}

bool aabbHitInv(vec3 origin, vec3 inv, vec3 mn, vec3 mx, float tMin, float tMax)
{
    vec3 t0 = (mn - origin) * inv;
    vec3 t1 = (mx - origin) * inv;
    float tNear = max(max(min(t0.x, t1.x), min(t0.y, t1.y)), max(min(t0.z, t1.z), tMin));
    float tFar = min(min(max(t0.x, t1.x), max(t0.y, t1.y)), min(max(t0.z, t1.z), tMax));
    return tNear <= tFar;
}

bool aabbHit(vec3 origin, vec3 dir, vec3 mn, vec3 mx, float tMax)
{
    return aabbHitInv(origin, invRay(dir), mn, mx, 0.0, tMax);
}

bool planeIntersect(vec3 ray, vec3 normal, vec3 origin, vec3 planePos, out vec3 hit)
{
    float denom = dot(ray, normal);
    if (abs(denom) > 1e-6) {
        float t = dot(planePos - origin, normal) / denom;
        if (t > 0.0) {
            hit = origin + ray * t;
            return true;
        }
    }
    hit = vec3(0.0);
    return false;
}

bool traverseBVHAny(uint nodeRoot, uint triIdxBase, uint triBase, vec3 origin, vec3 dir, float tMin, float tMax)
{
    vec3 inv = invRay(dir);
    uint stack[64];
    int sp = 0;
    stack[sp++] = nodeRoot;

    uint guard = 0u;
    while (sp > 0 && guard++ < RT_MAX_BVH_STEPS) {
        uint ni = stack[--sp];
        GpuBVHNode n = bvhNodes[ni];
        if (!aabbHitInv(origin, inv, n.aabbMin.xyz, n.aabbMax.xyz, tMin, tMax)) continue;

        uint leftFirst = n.data.x;
        uint triCount = n.data.y;
        if (triCount > 0u) {
            for (uint li = 0u; li < triCount; ++li) {
                uint localTri = triIndices[triIdxBase + leftFirst + li];
                GpuTriangle t = triangles[triBase + localTri];
                vec3 e1 = t.p2.xyz - t.p1.xyz;
                vec3 e2 = t.p3.xyz - t.p1.xyz;
                vec3 h = cross(dir, e2);
                float a = dot(e1, h);
                if (abs(a) < EPS) continue;
                float f = 1.0 / a;
                vec3 s = origin - t.p1.xyz;
                float u = f * dot(s, h);
                if (u < 0.0 || u > 1.0) continue;
                vec3 q = cross(s, e1);
                float v = f * dot(dir, q);
                if (v < 0.0 || u + v > 1.0) continue;
                float hitT = f * dot(e2, q);
                if (hitT > tMin && hitT < tMax) return true;
            }
        } else {
            if (sp + 1 < 64) {
                stack[sp++] = leftFirst;
                stack[sp++] = leftFirst + 1u;
            }
        }
    }
    return false;
}

bool testMeshAny(uint meshCellIndex, vec3 ray, vec3 localOrigin, float maxDist)
{
    GpuMeshCell mc = meshCells[meshCellIndex];
    GpuMesh m = meshes[mc.meshIndex];
    vec3 sc = m.scale.xyz;
    vec3 pv = m.pivot.xyz;
    vec3 center = m.modelCenter.xyz;

    vec3 shifted = localOrigin - m.offset.xyz - pv;
    vec3 rShifted = mulMat3T(m.rot0, m.rot1, m.rot2, shifted);
    vec3 mOrig = rShifted / sc + center;
    vec3 rRay = mulMat3T(m.rot0, m.rot1, m.rot2, ray);
    vec3 mDir = rRay / sc;
    mOrig += mDir * 1e-4;

    return traverseBVHAny(mc.nodeRoot, mc.triIdxBase, m.ranges.x, mOrig, mDir, 0.0, maxDist);
}

bool testRemoteAny(uint playerIndex, vec3 ray, vec3 localOrigin, float maxDist)
{
    GpuRemotePlayer rp = remotePlayers[playerIndex];
    if (rp.meta.x == 0u || rp.ranges.y == 0u) return false;
    if (!aabbHit(localOrigin, ray, rp.aabbMin.xyz, rp.aabbMax.xyz, maxDist)) return false;

    vec3 sc = rp.scale.xyz;
    vec3 pv = rp.pivot.xyz;
    vec3 center = rp.modelCenter.xyz;
    vec3 shifted = localOrigin - rp.offset.xyz - pv;
    vec3 rShifted = mulMat3T(rp.rot0, rp.rot1, rp.rot2, shifted);
    vec3 mOrig = rShifted / sc + center;
    vec3 rRay = mulMat3T(rp.rot0, rp.rot1, rp.rot2, ray);
    vec3 mDir = rRay / sc;
    mOrig += mDir * 1e-4;
    return traverseBVHAny(rp.ranges.z, rp.ranges.w, rp.ranges.x, mOrig, mDir, 0.0, maxDist);
}

bool traceAnyHit(vec3 origin, vec3 dir, float maxDist, vec3 sourceNormal)
{
    sourceNormal = safeNormalize(sourceNormal, vec3(0.0, 1.0, 0.0));
    float gmX = abs(dir.x) > 1e-6 ? abs(1.0 / dir.x) : INF;
    float gmY = abs(dir.y) > 1e-6 ? abs(1.0 / dir.y) : INF;
    float gmZ = abs(dir.z) > 1e-6 ? abs(1.0 / dir.z) : INF;

    vec3 fl = floor(origin);
    float smX = (dir.x < 0.0) ? (origin.x - fl.x) * gmX : (fl.x + 1.0 - origin.x) * gmX;
    float smY = (dir.y < 0.0) ? (origin.y - fl.y) * gmY : (fl.y + 1.0 - origin.y) * gmY;
    float smZ = (dir.z < 0.0) ? (origin.z - fl.z) * gmZ : (fl.z + 1.0 - origin.z) * gmZ;

    int mx = int(fl.x), my = int(fl.y), mz = int(fl.z);
    int side = 0;
    float dist = 0.0;

    uint ddaSteps = 0u;
    while (dist < maxDist && ddaSteps++ < RT_MAX_DDA_STEPS) {
        if (smX < smY && smX < smZ) {
            dist = smX; smX += gmX; mx += (dir.x < 0.0) ? -1 : 1; side = 0;
        } else if (smY < smZ) {
            dist = smY; smY += gmY; my += (dir.y < 0.0) ? -1 : 1; side = 1;
        } else {
            dist = smZ; smZ += gmZ; mz += (dir.z < 0.0) ? -1 : 1; side = 2;
        }
        if (!inBounds(mx, my, mz)) break;
        GpuCell cell = cells[gridIndex(mx, my, mz)];
        if (cell.itemCount == 0u) continue;

        vec3 hitFace = origin + dir * dist;
        float faceDist = (side == 0) ? smX - gmX : ((side == 1) ? smY - gmY : smZ - gmZ);
        if (faceDist > 0.001 && faceDist < maxDist) {
            for (uint ii = 0u; ii < cell.itemCount; ++ii) {
                GpuCellItem item = items[cell.firstItem + ii];
                if (item.type == 0u) return true;
                if (item.type == 1u) {
                    GpuPlane p = planes[item.index];
                    vec3 planeNormal = safeNormalize(p.normal.xyz, vec3(0.0, 1.0, 0.0));

                    // Thin planes are repeated per cell. A shadow ray launched from a
                    // floor/ceiling/wall pixel can otherwise immediately intersect the
                    // same coplanar plane again in a neighbouring cell, especially at
                    // grazing angles after depth reconstruction. That creates the large
                    // view-dependent black patches seen on floors and ceilings.
                    float planeStartDist = dot(origin - p.position.xyz, planeNormal);
                    float coplanarBias = max(0.05, rt.params.y * 4.0);
                    bool sameSurfacePlane =
                        abs(planeStartDist) < coplanarBias &&
                        abs(dot(planeNormal, sourceNormal)) > 0.94;

                    vec3 ph;
                    if (!planeIntersect(dir, planeNormal, origin, p.position.xyz, ph)) continue;
                    float E = 1e-4;
                    if (ph.x < float(mx) - E || ph.x > float(mx) + 1.0 + E ||
                        ph.y < float(my) - E || ph.y > float(my) + 1.0 + E ||
                        ph.z < float(mz) - E || ph.z > float(mz) + 1.0 + E) continue;
                    float d = length(ph - origin);
                    float minPlaneHit = max(0.03, rt.params.y * 2.0);
                    if (sameSurfacePlane) continue;
                    if (d > minPlaneHit && d < maxDist) return true;
                } else if (item.type == 2u) {
                    if (testMeshAny(item.index, dir, origin, maxDist)) return true;
                }
            }
        }
    }

    for (uint pi = 0u; pi < min(cam.screen.z, 16u); ++pi) {
        if (testRemoteAny(pi, dir, origin, maxDist)) return true;
    }
    return false;
}

ivec2 rtToGbufPix(ivec2 rtPix, ivec2 rtSize)
{
    ivec2 gSize = imageSize(imgDepth);
    vec2 uv = (vec2(rtPix) + vec2(0.5)) / max(vec2(rtSize), vec2(1.0));
    return clamp(ivec2(floor(uv * vec2(gSize))), ivec2(0), gSize - ivec2(1));
}

vec3 decodeNormal(ivec2 gPix)
{
    return safeNormalize(imageLoad(imgNormal, gPix).xyz * 2.0 - 1.0, vec3(0.0, 1.0, 0.0));
}

void buildCameraBasis(out vec3 forward, out vec3 right, out vec3 up,
                      out float rightLen, out float upLen)
{
    forward = safeNormalize(cam.dir.xyz, vec3(0.0, 0.0, 1.0));

    vec3 rawRight = cam.plane.xyz;
    vec3 rawUp = cam.upPlane.xyz;
    rightLen = max(length(rawRight), 1e-6);
    upLen = max(length(rawUp), 1e-6);

    right = rawRight - forward * dot(rawRight, forward);
    if (dot(right, right) <= 1e-12) {
        right = cross(rawUp, forward);
        if (dot(right, right) <= 1e-12) right = cross(vec3(0.0, 1.0, 0.0), forward);
        if (dot(right, right) <= 1e-12) right = vec3(1.0, 0.0, 0.0);
    }
    right = safeNormalize(right, vec3(1.0, 0.0, 0.0));
    if (dot(rawRight, rawRight) > 1e-12 && dot(right, rawRight) < 0.0) right = -right;

    // Preserve the sign of cam.upPlane. The previous "idealUp = cross(...)"
    // correction could silently invert the vertical axis for one camera
    // handedness, which makes floor/ceiling appear swapped.
    up = rawUp - forward * dot(rawUp, forward) - right * dot(rawUp, right);
    if (dot(up, up) <= 1e-12) {
        up = rawUp - forward * dot(rawUp, forward);
    }
    if (dot(up, up) <= 1e-12) {
        up = vec3(0.0, 1.0, 0.0) - forward * dot(vec3(0.0, 1.0, 0.0), forward);
    }
    if (dot(up, up) <= 1e-12) up = cross(forward, right);
    up = safeNormalize(up, vec3(0.0, 1.0, 0.0));
    if (dot(rawUp, rawUp) > 1e-12 && dot(up, rawUp) < 0.0) up = -up;
}

vec3 reconstructWorldPositionFromUv(vec2 uv, float depth)
{
    float ndcX = uv.x * 2.0 - 1.0;
    float ndcY = uv.y * 2.0 - 1.0;
    float nearZ = 0.03;
    float farZ = max(cam.fog.x, nearZ + 1.0);
    float z = nearZ + clamp(depth, 0.0, 1.0) * (farZ - nearZ);

    vec3 forward, right, up;
    float rightLen, upLen;
    buildCameraBasis(forward, right, up, rightLen, upLen);

    return cam.pos.xyz + forward * z + right * (ndcX * z * rightLen) + up * (-ndcY * z * upLen);
}

uint bayer8Rank(ivec2 pix)
{
    // 8x8 ordered pattern.  The RT quality slider now controls how many
    // pixels in each 8x8 tile cast expensive lighting/shadow rays:
    // 100% = 64/64 pixels, 1% = 1/64 pixels.
    const uint bayer[64] = uint[64](
         0u, 48u, 12u, 60u,  3u, 51u, 15u, 63u,
        32u, 16u, 44u, 28u, 35u, 19u, 47u, 31u,
         8u, 56u,  4u, 52u, 11u, 59u,  7u, 55u,
        40u, 24u, 36u, 20u, 43u, 27u, 39u, 23u,
         2u, 50u, 14u, 62u,  1u, 49u, 13u, 61u,
        34u, 18u, 46u, 30u, 33u, 17u, 45u, 29u,
        10u, 58u,  6u, 54u,  9u, 57u,  5u, 53u,
        42u, 26u, 38u, 22u, 41u, 25u, 37u, 21u);
    ivec2 p = pix & ivec2(7);
    return bayer[p.y * 8 + p.x];
}

vec3 decodeNormalAt(ivec2 p)
{
    ivec2 gSize = imageSize(imgDepth);
    p = clamp(p, ivec2(0), gSize - ivec2(1));
    return decodeNormal(p);
}

float localNormalComplexity(ivec2 gPix, ivec2 rtSize, vec3 centerNormal)
{
    // Estimate how safe interpolation is around this RT pixel.  On a large
    // floor/wall/ceiling plane the neighbouring normals are almost identical,
    // so only a few real shadow rays are needed and the spatial pass can fill
    // the rest.  Around corners, boxes and silhouettes the normals diverge;
    // those pixels keep a denser ray pattern.
    ivec2 gSize = imageSize(imgDepth);
    ivec2 stepPix = max(ivec2(1), ivec2(round(vec2(gSize) / max(vec2(rtSize), vec2(1.0)))));

    float minDot = 1.0;
    minDot = min(minDot, dot(centerNormal, decodeNormalAt(gPix + ivec2( stepPix.x, 0))));
    minDot = min(minDot, dot(centerNormal, decodeNormalAt(gPix + ivec2(-stepPix.x, 0))));
    minDot = min(minDot, dot(centerNormal, decodeNormalAt(gPix + ivec2(0,  stepPix.y))));
    minDot = min(minDot, dot(centerNormal, decodeNormalAt(gPix + ivec2(0, -stepPix.y))));

    // 0.0 = very flat/same normal, 1.0 = strong normal break.
    return clamp(1.0 - minDot, 0.0, 1.0);
}

bool shouldTrace(ivec2 pix, ivec2 gPix, ivec2 rtSize, vec3 centerNormal)
{
    if (rt.flags.x == 0u || rt.modes.x == 0u) return false;

    // rt.modes.x is the nominal samples-per-64 budget.  The adaptive part
    // spends fewer of those samples on locally flat normals and keeps or raises
    // the budget around normal discontinuities where interpolation would be
    // visible.
    uint nominal = clamp(rt.modes.x, 1u, 64u);

    float complexity = localNormalComplexity(gPix, rtSize, centerNormal);
    float edge = smoothstep(0.015, 0.22, complexity);

    // Flat surfaces trace only roughly one quarter of the nominal budget.
    // Hard normal breaks keep the nominal budget; at extremely low quality they
    // still get a small minimum so corners do not become pure blur.
    float flatBudget = max(1.0, ceil(float(nominal) * 0.25));
    float edgeBudget = float(nominal);
    if (edge > 0.65 && nominal < 4u) edgeBudget = 4.0;
    if (edge > 0.85 && nominal < 8u) edgeBudget = 8.0;

    uint adaptiveSamples = uint(clamp(round(mix(flatBudget, edgeBudget, edge)), 1.0, 64.0));
    return bayer8Rank(pix) < adaptiveSamples;
}

void main()
{
    ivec2 pix = ivec2(gl_GlobalInvocationID.xy);
    ivec2 rtSize = imageSize(imgRtRaw);
    if (pix.x >= rtSize.x || pix.y >= rtSize.y) return;

    // RT lighting can run at a lower resolution than the G-buffer.  Each RT
    // pixel shades the corresponding full-resolution G-buffer sample at the
    // same normalized screen position.
    ivec2 gPix = rtToGbufPix(pix, rtSize);
    vec2 uv = (vec2(pix) + vec2(0.5)) / max(vec2(rtSize), vec2(1.0));

    float depth = imageLoad(imgDepth, gPix).r;
    if (depth >= 0.99999) {
        imageStore(imgRtRaw, pix, vec4(rt.params.z, rt.params.z, rt.params.z, 1.0));
        return;
    }

    vec3 normal = decodeNormal(gPix);
    vec3 worldPos = reconstructWorldPositionFromUv(uv, depth);
    vec3 lighting = vec3(rt.params.z); // ambient

    if (!shouldTrace(pix, gPix, rtSize, normal)) {
        imageStore(imgRtRaw, pix, vec4(lighting, 0.0));
        return;
    }

    uint lightCount = rt.flags.w;

    // Trace every uploaded light that can affect this pixel.  This deliberately
    // removes the previous fixed shortlist/early-out cap, so maps with more
    // than a few lights accumulate all unblocked contributions.
    for (uint i = 0u; i < lightCount; ++i) {
        GpuLight l = lights[i];
        vec3 toLight = l.position.xyz - worldPos;
        float dist = length(toLight);
        float intensity = max(l.color.w, 0.0);
        float visibleRange = max(l.position.w, 0.25);
        if (dist <= 0.001 || dist > visibleRange || intensity <= 0.0) continue;

        vec3 L = toLight / dist;
        float ndotl = dot(normal, L);
        if (ndotl <= 0.0) continue; // >90 degrees from the light: do not trace.

        uint angle = l.angle;
        if (angle > 0u) {
            vec3 lightToFrag = normalize(-toLight);
            vec3 spotDir = normalize(l.normal);
            float cosTheta = dot(lightToFrag, spotDir);
            float cosCutoff = cos(radians(float(angle)));
            if (cosTheta < cosCutoff) continue;
        }

        float atten = intensity / (1.0 + dist * dist);
        float edgeFade = 1.0 - smoothstep(visibleRange * 0.88, visibleRange, dist);
        vec3 contribution = l.color.rgb * ndotl * atten * edgeFade;
        if (dot(contribution, vec3(0.2126, 0.7152, 0.0722)) <= 1e-7) continue;

        float baseBias = max(rt.params.y, 0.02);
        float slopeBias = baseBias * (1.0 + 3.0 * (1.0 - ndotl));
        vec3 origin = worldPos + normal * slopeBias + L * baseBias;
        bool blocked = traceAnyHit(origin, L, max(dist - slopeBias - baseBias, 0.001), normal);
        if (blocked) continue;

        lighting += contribution;
    }

    imageStore(imgRtRaw, pix, vec4(max(lighting, vec3(0.0)), 1.0));
}
